  {
    "id": "scheme-case-insensitive",
    "description": "the scheme token GW-HMAC-SHA256 is matched ignoring case",
    "survivesBase": true,
    "survivesHard": true,
    "caughtBy": [],
    "exampleChangesOutput": true,
    "example": {
      "method": "POST",
      "target": "/rt/auth",
      "headers": [
        [
          "X-GW-Key-Id",
          "gw-prod-01"
        ],
        [
          "Host",
          "redteam.example.net"
        ],
        [
          "Authorization",
          "gw-hmac-sha256 keyId=gw-prod-01, signature=9e9c6061854cd9c53724bb0936e3bcecd4d1eab12353983fbf61a1c0274d0f66"
        ]
      ],
      "body": "b"
