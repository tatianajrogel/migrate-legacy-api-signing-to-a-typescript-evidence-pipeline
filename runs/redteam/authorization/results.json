    "description": "a presented signature wrapped in double quotes is unquoted before comparison",
    "survivesBase": true,
    "survivesHard": true,
    "caughtBy": [],
    "exampleChangesOutput": true,
    "example": {
      "method": "POST",
      "target": "/rt/auth",
      "headers": [
        [
          "X-GW-Key-Id",
          "gw-prod-01"
        ],
        [
          "Host",
          "redteam.example.net"
        ],
        [
          "Authorization",
          "GW-HMAC-SHA256 keyId=gw-prod-01, signature=\"9e9c6061854cd9c53724bb0936e3bcecd4d1eab12353983fbf61a1c0274d0f66\""
        ]
      ],
      "body": "b"
    },
    "expectedLine": "{\"seq\":1,\"key_id\":\"gw-prod-01\",\"method\":\"POST\",\"path\":\"/rt/auth\",\"outcome\":\"rejected\",\"signature\":\"9e9c6061854cd9c53724bb0936e3bcecd4d1eab12353983fbf61a1c0274d0f66\",\"canonical_sha256\":\"dd0c0fc162bcde1d974ecfed27138cd748491e13abb5b680f8a8fc20736283b3\",\"reason\":\"signature-mismatch\"}",
    "departureLine": "{\"seq\":1,\"key_id\":\"gw-prod-01\",\"method\":\"POST\",\"path\":\"/rt/auth\",\"outcome\":\"verified\",\"signature\":\"9e9c6061854cd9c53724bb0936e3bcecd4d1eab12353983fbf61a1c0274d0f66\",\"canonical_sha256\":\"dd0c0fc162bcde1d974ecfed27138cd748491e13abb5b680f8a8fc20736283b3\"}",
    "diffs": {
      "base": {},
      "hard": {}
    }
  },
